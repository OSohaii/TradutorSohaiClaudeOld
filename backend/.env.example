# MangaLens Backend BFF — environment variables
#
# All keys are OPTIONAL. The backend supports two modes per provider:
#   1. Server-managed: the key below is used as the default for every request.
#   2. Bring Your Own Key (BYOK): clients send the user's key in a request
#      header and it overrides the server key for that request only.
#
# If neither a server key nor a BYOK header is provided for a given engine,
# the backend returns 422 with a clear error.

# --- Provider keys (server-managed defaults) ---

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# DeepL API key (Free key ends in ":fx", Pro keys do not)
DEEPL_API_KEY=

# Torii Translate API key
TORII_API_KEY=

# Google Cloud Translation API key (only required if you want the paid endpoint;
# the free GTX endpoint used by the GOOGLE engine does not need a key)
GOOGLE_API_KEY=

# Ichigo: there is no shared "server token" — each user logs in with their own
# Ichigo account through POST /api/ichigo/login and the resulting bearer token
# is sent back as X-Byok-Ichigo on subsequent requests.

# --- Server settings ---

# Comma-separated list of allowed CORS origins. Use "*" only for local dev.
# Example: CORS_ORIGINS=http://localhost:5173,https://mangalens.example.com
CORS_ORIGINS=http://localhost:5173

# Set to "development" to enable verbose error messages and CORS wildcard.
ENVIRONMENT=development

# Maximum image size accepted by /api/pipeline (in bytes, base64-decoded).
MAX_IMAGE_BYTES=15728640
